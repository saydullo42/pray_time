<?xml version="1.0" encoding="utf-8"?>
<!-- Same as backup_rules.xml, for Android 12 and higher (cloud backup and device transfer). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml"/>
    </device-transfer>
</data-extraction-rules>
