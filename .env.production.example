# Copy to ".env" on the server (same folder as docker-compose.yml) and fill in.
# This file is NOT committed; never share the real values.

# Domains (DNS A records of both must point at the server's IP)
SITE_DOMAIN=pray-time.uz
API_DOMAIN=api.pray-time.uz

# Generate each secret on the server:
#   openssl rand -hex 24          -> POSTGRES_PASSWORD
#   openssl rand -base64 60       -> DJANGO_SECRET_KEY   (or: python3 -c "import secrets;print(secrets.token_urlsafe(60))")
POSTGRES_PASSWORD=
DJANGO_SECRET_KEY=

# Google OAuth *web* client id (public, not a secret)
GOOGLE_CLIENT_ID=

# Leave 0 until you've checked that HTTPS works for both domains, then use
# 31536000 (1 year) so browsers only ever use HTTPS.
DJANGO_HSTS_SECONDS=0
